# Backend API Base URL
# In local dev: leave blank or set to http://127.0.0.1:8000
# In production: https://your-backend-service.onrender.com
VITE_API_URL=http://127.0.0.1:8000

# Stripe Elements Client-Side Public Key (Optional)
# Format: pk_test_... or pk_live_...
VITE_STRIPE_PUBLIC_KEY=

# Crisp Live Customer Support Chat (Optional)
# If empty, the chat widget is gracefully disabled with zero console warnings.
VITE_CRISP_WEBSITE_ID=

# Product Analytics & Telemetry (Optional)
# If empty, falls back to console logging in development mode.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_GA_MEASUREMENT_ID=
