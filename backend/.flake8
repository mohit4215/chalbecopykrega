[flake8]
max-line-length = 120
exclude = 
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    .pytest_cache,
    cache
ignore = 
    # E203: whitespace before ':' (black compatibility)
    E203,
    # W503: line break before binary operator
    W503,
    # E501: line too long (handled by max-line-length)
    E501
per-file-ignores =
    __init__.py: F401
