# Database Configuration
# SQLite is the default for single-service deployments; a PostgreSQL URL also works.
DATABASE_URL=sqlite+aiosqlite:///./plagiarism_auth.db
USE_IN_MEMORY_FALLBACK=true

# Embeddings
# true = deterministic hashed bag-of-words (no torch download, low memory).
# false = dense sentence-transformers model (install requirements-ml.txt first).
USE_HASHED_EMBEDDINGS=true
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu

# Background jobs
# When REDIS_URL/CELERY_BROKER_URL is empty, scans run inline in the API process
# (the default). Set REDIS_URL and CELERY_ALWAYS_EAGER=false to use a worker.
CELERY_ALWAYS_EAGER=true
REDIS_URL=

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Stripe (webhooks are rejected when the secret is missing/invalid)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_UNSIGNED_WEBHOOKS=false

# External Search Cross-Referencing APIs
# (Optional: if empty, the system uses DuckDuckGo free search and the internal corpus)
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=
