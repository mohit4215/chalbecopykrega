# Database Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/plagiarism_db
USE_IN_MEMORY_FALLBACK=true

# External Search Cross-Referencing APIs
# (Optional: If empty, system automatically uses DuckDuckGo free search and internal corpus)
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=

# HuggingFace & Model Settings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu
