# ==============================================================================
# Environment Configuration Template for Plagiarism Detection SaaS
# Copy this file to .env and populate with production credentials
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
PORT=8000
CORS_ORIGINS=["*"]
MAX_FILE_SIZE_MB=50

# ------------------------------------------------------------------------------
# Vector Database Configuration (Qdrant)
# ------------------------------------------------------------------------------
# Internal Docker network URL (used by backend to query Qdrant)
QDRANT_URL=http://vector-db:6333
QDRANT_COLLECTION_NAME=student_submissions

# Optional: PostgreSQL + pgvector (if utilizing dual relational/vector storage)
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/plagiarism_db
USE_IN_MEMORY_FALLBACK=false

# ------------------------------------------------------------------------------
# External Web Cross-Referencing APIs
# (At least one key is recommended for live internet verification)
# ------------------------------------------------------------------------------
# SerpAPI (Google Search): https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_key_here

# Microsoft Bing Web Search API: https://portal.azure.com/
BING_SEARCH_API_KEY=your_bing_api_key_here

# ------------------------------------------------------------------------------
# NLP & Machine Learning Engine
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu
CHUNK_SIZE_WORDS=50
CHUNK_OVERLAP_WORDS=20

# ------------------------------------------------------------------------------
# OCR & Ingestion Pipeline
# ------------------------------------------------------------------------------
ENABLE_OCR=true
OCR_LANGUAGES=eng
MIN_DIGITAL_TEXT_THRESHOLD_PER_PAGE=25
