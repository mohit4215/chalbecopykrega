# ==============================================================================
# Environment Configuration Template for Poach Academic Originality Engine
# Copy this file to .env and populate with your credentials
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
PORT=8000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=https://chalbecopykrega-app.onrender.com,http://localhost:80,http://localhost:5173

# ------------------------------------------------------------------------------
# PostgreSQL Database (User Accounts, Scan History, Subscriptions, Reference Corpus)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=plagiarism_db
# For Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@db:5432/plagiarism_db
# For Local Development:
# DATABASE_URL=sqlite+aiosqlite:///./plagiarism_auth.db
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25

# ------------------------------------------------------------------------------
# Redis (Distributed Caching, Celery Broker & Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Set to true for single-process local development without Redis
CELERY_ALWAYS_EAGER=false

# ------------------------------------------------------------------------------
# Vector Database Configuration (Qdrant & In-Memory Fallback)
# ------------------------------------------------------------------------------
QDRANT_URL=http://vector-db:6333
QDRANT_COLLECTION_NAME=student_submissions
USE_IN_MEMORY_FALLBACK=false

# ------------------------------------------------------------------------------
# JWT Authentication & Security
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_random_48_char_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_UNSIGNED_WEBHOOKS=false

# ------------------------------------------------------------------------------
# Stripe Payments & Institutional Subscriptions
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ------------------------------------------------------------------------------
# External Web & Academic Search APIs
# ------------------------------------------------------------------------------
# SerpAPI (Google Search): https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_key_here

# Microsoft Bing Web Search API: https://portal.azure.com/
BING_SEARCH_API_KEY=your_bing_api_key_here

# ------------------------------------------------------------------------------
# NLP & Machine Learning Engine
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu
CHUNK_SIZE_WORDS=50
CHUNK_OVERLAP_WORDS=20
ENABLE_ONNX_EMBEDDINGS=true
ONNX_INTRA_THREADS=4

# ------------------------------------------------------------------------------
# OCR & Ingestion Pipeline
# ------------------------------------------------------------------------------
ENABLE_OCR=true
OCR_LANGUAGES=eng
MIN_DIGITAL_TEXT_THRESHOLD_PER_PAGE=25
